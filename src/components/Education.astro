---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const dateLines = (range: string) => range.split(/\s+-\s+/).map((d, i) => (i ? `– ${d}` : d));
---

{
  hasEducation && (
    <section id="education" class="hs">
      <div class="hs-inner">
        <div class="hs-head">
          <h2 class="hs-title">Education</h2>
          <div class="rule mt-4" />
        </div>

        <ol class="tl">
          {siteConfig.education.map((edu) => (
            <li class="tl-item">
              <p class="tl-date">
                <span class="tl-dot" aria-hidden="true" />
                {dateLines(edu.dateRange).map((d) => <span>{d}</span>)}
              </p>
              <div class="tl-card">
                <div>
                  <h3 class="tl-role">{edu.degree}</h3>
                  <p class="tl-org">{edu.school}</p>
                </div>
                <ul class="tl-list">
                  {edu.achievements.map((achievement) => <li>{achievement}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
