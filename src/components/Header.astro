---
import { siteConfig } from "../config";
import { navLinks } from "../nav";

const links = navLinks;

// Normalize current path (strip trailing slash) for active-link matching.
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(href + "/");
};
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b border-white/5 transition-all duration-300 overflow-hidden"
  style={{ backgroundColor: "color-mix(in srgb, var(--bg) 82%, transparent)" }}
>
  <!-- Faint grid pattern, matches footer -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full opacity-[0.04] [mask-image:linear-gradient(to_right,transparent,white_30%,white_70%,transparent)]"
    style={{ stroke: 'var(--grid-stroke)' }}
  >
    <defs>
      <pattern x="50%" y={-1} id="header-grid-pattern" width={40} height={40} patternUnits="userSpaceOnUse">
        <path d="M.5 40V.5H40" fill="none"></path>
      </pattern>
    </defs>
    <rect fill="url(#header-grid-pattern)" width="100%" height="100%" stroke-width={0}></rect>
  </svg>

  <nav class="hdr">
    <!-- brand: amber slash, name, discipline -->
    <a href="/" class="hdr-brand">
      <span class="hdr-slash" aria-hidden="true"></span>
      <span class="hdr-id">
        <span class="hdr-name">{siteConfig.name}</span>
        <span class="hdr-role">Technical Artist</span>
      </span>
    </a>

    <ul class="hdr-links hidden md:flex">
      {
        links.map((link, i) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={`nav-link relative flex items-center gap-3 py-1 font-mono text-[12.5px] font-medium uppercase tracking-[0.1em] transition-colors duration-300 ${
                isActive(link.href) ? "nav-link-active" : ""
              }`}
            >
              <span class="nav-num">{String(i + 1).padStart(2, "0")}</span>
              {link.label}
              <span class="nav-underline"></span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- terminal-green status lamp -->
    <div class="hdr-status" aria-hidden="true">
      <span class="status-dot inline-block w-2 h-2 rounded-full"></span>
      <span class="hdr-status-text">
        <span class="hdr-status-label">ShaderTrix Unified OS</span>
        <span class="hdr-status-sub">Guest access // <b>Granted</b></span>
        <span class="hdr-status-time">Local <span data-local-time></span></span>
      </span>
    </div>

    <!-- light mode is off for now
    <button id="theme-toggle" type="button" aria-label="Toggle theme" class="theme-toggle">
      <span class="theme-toggle-track"><span class="theme-toggle-thumb"></span></span>
    </button>
    <button id="theme-toggle-mobile" type="button" aria-label="Toggle theme" class="theme-toggle">
      <span class="theme-toggle-track"><span class="theme-toggle-thumb"></span></span>
    </button>
    -->
  </nav>

  <!-- Mobile sub-menu: same tabs as desktop, always visible, no hamburger needed -->
  <ul class="mobile-subnav flex md:hidden items-center justify-center gap-5 overflow-x-auto py-2.5 border-t border-white/5 px-6">
    {
      links.map((link) => (
        <li class="flex-shrink-0">
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class={`nav-link relative inline-flex items-center py-1 font-mono text-[11px] uppercase tracking-[0.14em] whitespace-nowrap transition-colors duration-300 ${
              isActive(link.href) ? "nav-link-active" : "text-gray-400"
            }`}
          >
            {link.label}
            <span class="nav-underline"></span>
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  // light mode is off for now (see Layout.astro / global.css)
  // function toggleTheme() {
  //   const current = document.documentElement.getAttribute("data-theme") || "dark";
  //   const next = current === "dark" ? "light" : "dark";
  //   document.documentElement.setAttribute("data-theme", next);
  //   localStorage.setItem("theme", next);
  // }
  // document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
  // document.getElementById("theme-toggle-mobile")?.addEventListener("click", toggleTheme);

  // the visitor's local time under the status lamp, ticking each second
  import { localTime } from "../scripts/local-time";
  const clock = document.querySelector<HTMLElement>("[data-local-time]");
  if (clock) {
    const tick = () => (clock.textContent = localTime());
    tick();
    setInterval(tick, 1000);
  }

  // Home page: the 3D gallery opens full screen with the header tucked away; it slides down
  // once you scroll (or "Go to Website") past the gallery.
  const gallery = document.querySelector("[data-gallery][data-embedded]");
  const header = document.getElementById("header");
  if (gallery && header) {
    const update = () => header.classList.toggle("header-tucked", gallery.getBoundingClientRect().bottom > innerHeight * 0.5);
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  :global(#header.header-tucked) {
    transform: translateY(-100%);
  }
  .mobile-subnav {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .mobile-subnav::-webkit-scrollbar {
    display: none;
  }
  /* brand | centred numbered nav | status */
  .hdr {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    height: 72px;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .hdr-brand {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    justify-self: start;
    text-decoration: none;
  }
  .hdr-slash {
    width: 3px;
    height: 34px;
    background: var(--accent);
  }
  .hdr-id { display: flex; flex-direction: column; gap: 6px; }
  .hdr-name {
    font: 700 16px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    white-space: nowrap;
  }
  .hdr-role {
    font: 400 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    opacity: 0.8;
    white-space: nowrap;
  }
  .hdr-brand:hover .hdr-name { color: var(--accent); }
  .hdr-links {
    align-items: center;
    gap: clamp(1.5rem, 3.2vw, 3.25rem);
    padding: 0 1.5rem;
  }
  .hdr-links .nav-link { color: var(--text-secondary); }
  .hdr-status {
    display: none;
    align-items: center;
    justify-self: end;
    gap: 0.85rem;
  }
  .hdr-status-label {
    font: 400 11.5px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-primary);
    white-space: nowrap;
  }
  .hdr-status-text { display: flex; flex-direction: column; gap: 5px; }
  .hdr-status-sub {
    font: 400 10.5px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    opacity: 0.8;
    white-space: nowrap;
  }
  .hdr-status-sub b { font-weight: 500; color: var(--signal); }
  .hdr-status-time {
    font: 400 9.5px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .hdr-status-time span { color: var(--text-secondary); }
  @media (min-width: 1100px) { .hdr-status { display: flex; } }
  @media (max-width: 767px) {
    .hdr { height: 60px; grid-template-columns: 1fr; }
  }
  .nav-num {
    color: inherit;
    transition: color 0.3s;
  }
  .nav-underline {
    position: absolute;
    bottom: -12px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover .nav-underline,
  .nav-link-active .nav-underline {
    transform: scaleX(1);
  }
  .nav-link:hover,
  .nav-link-active,
  .nav-link:hover .nav-num,
  .nav-link-active .nav-num {
    color: var(--accent);
  }
  /* terminal-green "online" lamp */
  .status-dot {
    background: var(--signal);
    box-shadow: 0 0 6px var(--signal);
    animation: status-blink 2.4s ease-in-out infinite;
  }
  @keyframes status-blink { 50% { opacity: 0.45; } }

  /* light mode is off for now: theme toggle styles kept for when it comes back
  .theme-toggle { background: none; border: none; padding: 0; cursor: pointer; line-height: 0; }
  .theme-toggle-track { position: relative; display: block; width: 48px; height: 26px; border-radius: 9999px;
    background-color: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.08); transition: background-color 0.3s, border-color 0.3s; }
  .theme-toggle-thumb { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 9999px;
    background-color: var(--accent); box-shadow: 0 0 6px var(--accent-dim); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); z-index: 2; }
  */
</style>