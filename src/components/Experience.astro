---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
// "Jul 2024 - Present" -> ["Jul 2024", "– Present"] for the two-line timeline date
const dateLines = (range: string) => range.split(/\s+-\s+/).map((d, i) => (i ? `– ${d}` : d));
---

{
  hasExperience && (
    <section id="experience" class="hs">
      <div class="hs-inner">
        <div class="hs-head">
          <h2 class="hs-title">Experience</h2>
          <div class="rule mt-4" />
          <a class="hs-btn" href={siteConfig.resumeUrl} target="_blank" rel="noopener">
            View full resume <span aria-hidden="true">→</span>
          </a>
        </div>

        <ol class="tl">
          {siteConfig.experience.map((exp, i) => (
            <li class="tl-item">
              <p class={`tl-date ${i === 0 ? "is-current" : ""}`}>
                <span class="tl-dot" aria-hidden="true" />
                {dateLines(exp.dateRange).map((d) => <span>{d}</span>)}
              </p>
              <div class="tl-card">
                <div>
                  <h3 class="tl-role">{exp.role || exp.title}</h3>
                  <p class="tl-org">{exp.company}</p>
                </div>
                <div>
                  <p class="tl-desc">{exp.description}</p>
                  {exp.highlights && (
                    <ul class="tl-list">
                      {exp.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
