---
import { siteConfig } from "../config";
import { ICONS } from "../brand-icons";
---

<section id="about">
  <div class="hs">
    <div class="hs-inner">
      <div class="hs-head">
        <h2 class="hs-title">About Me</h2>
        <div class="rule mt-4"></div>

        <!-- square portrait, fading into the page, in the site's corner-bracket frame -->
        <figure class="ab-portrait corners">
          <img src="/about/portrait.webp" alt="Shivanshu Chauhan" width="600" height="600" loading="lazy" decoding="async" />
          <span class="ab-portrait-shade" aria-hidden="true"></span>
        </figure>
      </div>

      <div>
        <!-- intro paragraph opens the right column; the title column stays clear -->
        <p class="ab-intro">
          Hey, I'm Shivanshu Chauhan — a Technical Artist working in <em class="hs-em">Unreal Engine 5 and Unity</em>. I spend most of my time building shaders, VFX, procedural tools and editor automation, and profiling what I build so it holds its frame budget. Performance is the part I'm best at.
        </p>
        <p class="ab-eu">Portuguese passport (EU citizen), no visa sponsorship needed <span class="ab-eu-sep" aria-hidden="true">|</span> <span class="ab-eu-keep">Open to relocation or remote</span></p>
        <ul class="ab-points">
          <li>
            <span class="ab-slash" aria-hidden="true">/</span>
            <p>Right now most of my own work is in Unreal 5 — a Lumen scene I took from 22 fps to 43, a data-driven PCG forest tool with a custom C++ editor window, and a Nanite tessellation sand system.</p>
          </li>
          <li>
            <span class="ab-slash" aria-hidden="true">/</span>
            <p>At work I own the CPU/GPU frame budget on a live mobile title, so I care a lot about making things look good while still running smoothly on hardware that has nothing to spare.</p>
          </li>
          <li>
            <span class="ab-slash" aria-hidden="true">/</span>
            <p>Outside of production work I'm usually sculpting, texturing, or tinkering with rendering tricks just for fun.</p>
          </li>
        </ul>

        <ul class="hs-tags ab-skills">
          {siteConfig.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </div>
  </div>

  {siteConfig.toolStack && siteConfig.toolStack.length > 0 && (
    <div class="hs">
      <div class="hs-inner">
        <div class="hs-head">
          <h2 class="hs-title">Toolstack</h2>
          <div class="rule mt-4"></div>
        </div>

        <div class="ts-groups">
          {siteConfig.toolStack.map((group) => (
            <div class="ts-group">
              <p class="ts-label">{group.category}</p>
              <ul class="ts-items">
                {group.items.map((item) => (
                  <li class="ts-item">
                    {item.icon && ICONS[item.icon] ? (
                      <svg class="ts-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d={ICONS[item.icon]} />
                      </svg>
                    ) : (
                      <span class="ts-mono" aria-hidden="true">{item.name.slice(0, 2)}</span>
                    )}
                    <span class="ts-name">{item.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</section>

<style>
  /* About Me portrait: square photo with a dark gradient (vignette plus a
     fade at the bottom into the page), framed like the project tiles (.corners in global.css) */
  .ab-portrait {
    width: min(100%, 240px);
    aspect-ratio: 1;
    margin: 2.5rem 0 0;
  }
  .ab-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ab-portrait-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 95% at 50% 35%, transparent 45%, rgb(11 11 10 / 0.7) 100%),
      linear-gradient(to bottom, transparent 55%, rgb(11 11 10 / 0.85) 100%);
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .ab-portrait { width: 200px; margin-top: 2rem; }
  }

  /* tool groups in aligned columns, each behind a charcoal divider */
  .ts-groups {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    row-gap: 2.5rem;
    align-self: center;
  }
  .ts-group {
    padding: 0 clamp(1rem, 2vw, 1.75rem);
    border-left: 1px solid var(--border);
  }
  .ts-label {
    margin-bottom: 1.4rem;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .ts-items {
    display: flex;
    gap: 1.1rem 0.75rem;
  }
  .ts-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    width: 66px;
    color: var(--text-primary);
    transition: color 0.2s;
  }
  .ts-item:hover { color: var(--accent); }
  .ts-icon { width: 38px; height: 38px; }
  /* tools without a logo: a beige key-cap monogram */
  .ts-mono {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 3px;
    background: var(--text-primary);
    color: var(--bg);
    font: 800 17px/1 var(--font-display);
    text-transform: uppercase;
    transition: background-color 0.2s;
  }
  .ts-item:hover .ts-mono { background: var(--accent); }
  .ts-name {
    font: 400 11px/1.25 var(--font-mono);
    color: var(--text-secondary);
    text-align: center;
  }

  .ab-intro {
    max-width: 72ch;
    margin-bottom: 1rem;
    font: 400 15px/1.8 var(--font-mono);
    color: var(--text-primary);
  }
  /* work-rights line under the intro, bold and in amber (same wording as the CV) */
  .ab-eu {
    max-width: 72ch;
    margin-bottom: 2.75rem;
    font: 700 15px/1.7 var(--font-mono);
    color: var(--accent);
  }
  .ab-eu-sep { margin: 0 0.4em; font-weight: 400; color: var(--text-secondary); }
  .ab-eu-keep { white-space: nowrap; }   /* wraps as a whole after the bar, never mid-phrase */
  /* three short statements, each led by an amber slash */
  .ab-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .ab-points li {
    display: flex;
    gap: 1rem;
    padding: 0.25rem clamp(1rem, 2vw, 1.75rem);
    border-left: 1px solid var(--border);
  }
  .ab-slash {
    font: 700 20px/1.1 var(--font-mono);
    color: var(--accent);
    transform: skewX(-8deg);
  }
  .ab-points p {
    font: 400 13.5px/1.75 var(--font-mono);
    color: var(--text-secondary);
  }
  .ab-skills {
    margin-top: 2.5rem;
    padding-left: clamp(1rem, 2vw, 1.75rem);
  }
  @media (max-width: 1023px) {
    .ts-groups { grid-template-columns: 1fr; }
    .ts-group, .ab-points li { border-left: 0; padding-left: 0; }
    .ts-items { flex-wrap: wrap; }
    .ab-points { grid-template-columns: 1fr; gap: 1.5rem; }
    .ab-skills { padding-left: 0; }
  }
</style>
