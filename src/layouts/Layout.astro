---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  /** search/link-preview description; defaults to siteConfig.description */
  description?: string;
  /** content starts at the very top, under the (tucked) header: the home page's gallery */
  flush?: boolean;
}

const { title, description = siteConfig.description, flush = false } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.name}` : siteConfig.siteTitle;
const pageUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).href;
const ogImage = new URL(siteConfig.ogImage, siteConfig.siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <!-- link previews (LinkedIn, Slack, email, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name}, Technical Artist`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Barlow Condensed: headings · Inter: body · JetBrains Mono: labels and code -->
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <!-- light mode is off for now; restore this (and the toggle in Header.astro) to bring it back
    <script is:inline>
      (function(){
        var t = localStorage.getItem("theme") || "dark";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    -->
    <script is:inline>document.documentElement.setAttribute("data-theme", "dark");</script>
  </head>
  <body style={{ backgroundColor: "var(--bg)" }}>
    <div class="fixed inset-0 -z-10">
      <img
        src="/bg.png"
        alt=""
        class="fixed-bg-image w-full h-full object-cover transition-opacity duration-500"
      />
    </div>

    <!-- hazard-stripe concrete strips down both page edges (global.css .page-strips) -->
    <div class={`page-strips${flush ? " after-hero" : ""}`} aria-hidden="true"></div>
    <Header />
    <main class={flush ? "" : "pt-[100px] md:pt-[72px]"}>
      <slot />
    </main>
    <Footer />
    <script>
      import { initScrollMemory } from "../scripts/scroll-memory";
      initScrollMemory();
    </script>
  </body>
</html>
