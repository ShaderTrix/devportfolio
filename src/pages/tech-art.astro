---
import Layout from "../layouts/Layout.astro";
import { allProjects } from "../config";

const projects = allProjects.filter(
  (project) => project.categoryKey === "professional" || project.categoryKey === "personal"
);

const engineOf = (p: { engine?: string }) => (p.engine === "unreal" ? "unreal" : "unity");
const engineName = (p: { engine?: string }) => (engineOf(p) === "unreal" ? "Unreal" : "Unity");
// small label above each title, from real data: shipped vs personal, and the engine
const kindOf = (p: { categoryKey?: string; engine?: string }) =>
  `${p.categoryKey === "professional" ? "Production" : "Personal"} / ${engineName(p)}`;
// engine first, then skills (skipping one that just repeats the engine)
const tagsOf = (p: { engine?: string; skills?: string[] }) => {
  const e = engineName(p);
  return [e, ...(p.skills ?? []).filter((t) => t.toLowerCase() !== e.toLowerCase()).slice(0, 4)];
};
// extra stills beside the main image, only where the project really has them
const thumbsOf = (p: { image?: string; inlineImage?: string; detailImage?: string }) =>
  [...new Set([p.inlineImage, p.detailImage].filter((u): u is string => !!u && u !== p.image))].slice(0, 3);
const pad = (n: number) => String(n).padStart(2, "0");

// Engine badge icons (Simple Icons path data, rendered with currentColor)
const ENGINE_ICONS: Record<string, string> = {
  unity: "m12.9288 4.2939 3.7997 2.1929c.1366.077.1415.2905 0 .3675l-4.515 2.6076a.4192.4192 0 0 1-.4246 0L7.274 6.8543c-.139-.0745-.1415-.293 0-.3675l3.7972-2.193V0L1.3758 5.5977V16.793l3.7177-2.1456v-4.3858c-.0025-.1565.1813-.2682.318-.1838l4.5148 2.6076a.4252.4252 0 0 1 .2136.3676v5.2127c.0025.1565-.1813.2682-.3179.1838l-3.7996-2.1929-3.7178 2.1457L12 24l9.6954-5.5977-3.7178-2.1457-3.7996 2.1929c-.1341.082-.3229-.0248-.3179-.1838V13.053c0-.1565.087-.2956.2136-.3676l4.5149-2.6076c.134-.082.3228.0224.3179.1838v4.3858l3.7177 2.1456V5.5977L12.9288 0Z",
  unreal: "M12 0a12 12 0 1012 12A12 12 0 0012 0zm0 23.52A11.52 11.52 0 1123.52 12 11.52 11.52 0 0112 23.52zm7.13-9.791c-.206.997-1.126 3.557-4.06 4.942l-1.179-1.325-1.988 2a7.338 7.338 0 01-5.804-2.978 2.859 2.859 0 00.65.123c.326.006.678-.114.678-.66v-5.394a.89.89 0 00-1.116-.89c-.92.212-1.656 2.509-1.656 2.509a7.304 7.304 0 012.528-5.597 7.408 7.408 0 013.73-1.721c-1.006.573-1.57 1.507-1.57 2.29 0 1.262.76 1.109.984.923v7.28a1.157 1.157 0 00.148.256 1.075 1.075 0 00.88.445c.76 0 1.747-.868 1.747-.868V9.172c0-.6-.452-1.324-.905-1.572 0 0 .838-.149 1.484.346a5.537 5.537 0 01.387-.425c1.508-1.48 2.929-1.902 4.112-2.112 0 0-2.151 1.69-2.151 3.96 0 1.687.043 5.801.043 5.801.799.771 1.986-.342 3.059-1.441Z",
};
---

<Layout title="Techart">
  <section class="tx relative isolate overflow-hidden py-14 sm:py-16" style={{ backgroundColor: "var(--bg)" }}>
    <svg
      aria-hidden="true"
      class="absolute inset-0 -z-10 size-full opacity-[0.3] [mask-image:radial-gradient(100%_100%_at_top_left,white,transparent)]"
      style={{ stroke: "var(--grid-stroke)" }}
    >
      <defs>
        <pattern x="50%" y={-1} id="techart-grid-pattern" width={40} height={40} patternUnits="userSpaceOnUse">
          <path d="M.5 40V.5H40" fill="none"></path>
        </pattern>
      </defs>
      <rect fill="url(#techart-grid-pattern)" width="100%" height="100%" stroke-width={0}></rect>
    </svg>

    <div class="tx-wrap">
      <!-- page header: title | amber rule + blurb | selected-works count; filters underneath -->
      <header class="tx-head animate-fade-in">
        <div class="tx-title-col">
          <p class="tx-kicker"><span>//</span> Projects</p>
          <h1 class="tx-title">Technical Art<br />Projects</h1>
        </div>
        <div class="tx-blurb">
          <p>A few of my techart stuff/projects — a mix of systems I've shipped on <em>production mobile games</em> and personal projects I built just to learn and mess around with.</p>
          <p>Some of these were built for real teams with millions of players, others were <em>weekend experiments</em> that got a bit out of hand.</p>
          <p>If anything here interests you or you want to chat about how something works, feel free to reach out.</p>
        </div>
        <a href="#works" class="tx-count" aria-label={`${projects.length} selected works`}>
          <span class="tx-count-label">Selected<br />works</span>
          <span class="tx-count-num">{String(projects.length).padStart(2, "0")}</span>
        </a>
      </header>

      {projects.length > 0 && (
        <div id="engine-filter" class="tx-filters animate-fade-in animation-delay-200" role="group" aria-label="Filter by engine">
          <button type="button" data-filter="all" class="filter-btn active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>All Projects
          </button>
          <button type="button" data-filter="unity" class="filter-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ENGINE_ICONS.unity} /></svg>Unity
          </button>
          <button type="button" data-filter="unreal" class="filter-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ENGINE_ICONS.unreal} /></svg>Unreal
          </button>
        </div>
      )}

      {projects.length > 0 ? (
        <ol id="works" class="tx-list">
          {projects.map((project, index) => {
            const thumbs = thumbsOf(project);
            return (
              <li class={`project-card tx-row${index % 2 ? " is-flip" : ""}`} data-engine={engineOf(project)}>
                <a href={`/projects/${project.slug}`} class={`tx-media${thumbs.length ? " has-thumbs" : ""}`} tabindex="-1" aria-hidden="true">
                  <span class="tx-main" style={`background-image: url('${project.image || ""}')`}></span>
                  {thumbs.length > 0 && (
                    <span class="tx-thumbs">
                      {thumbs.map((t) => <span style={`background-image: url('${t}')`}></span>)}
                    </span>
                  )}
                </a>
                <div class="tx-text">
                  <span class="tx-num" aria-hidden="true">{pad(index + 1)}</span>
                  <div class="tx-copy">
                  <p class="tx-kind">{kindOf(project)}</p>
                  <h2 class="tx-name"><a href={`/projects/${project.slug}`}>{project.name}</a></h2>
                  <p class="tx-desc">{project.description || project.tagline}</p>
                  <div class="tx-tags">{tagsOf(project).map((t) => <span>{t}</span>)}</div>
                  <a href={`/projects/${project.slug}`} class="tx-cta">View project <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </li>
            );
          })}
        </ol>
      ) : (
        <div class="mt-12 text-center text-gray-400">No projects yet.</div>
      )}
    </div>
  </section>

  <style>
    /* Techart page, editorial list: one project per row, alternating sides; amber for the
       numbers, selected filter and links */
    .tx-wrap {
      width: 100%;
      max-width: 1360px;
      margin-inline: auto;
      padding-inline: clamp(22px, 6vw, 96px);
    }

    /* ---- page header ---- */
    .tx-head {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 1.5rem 2.25rem;
    }
    .tx-kicker {
      margin: 0 0 0.75rem;
      font: 500 12px var(--font-mono);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .tx-kicker span { color: var(--accent); margin-right: 0.4em; }
    .tx-title {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(48px, 5.6vw, 84px);
      line-height: 0.9;
      text-transform: uppercase;
      color: var(--text-primary);
    }
    .tx-blurb {
      align-self: end;
      max-width: 640px;
      margin: 0 0 0.4rem;
      padding-left: 1.5rem;
      border-left: 2px solid var(--accent);
      font: 400 12.5px/1.7 var(--font-mono);
      color: var(--text-secondary);
    }
    .tx-blurb p { margin: 0; }
    .tx-blurb p + p { margin-top: 0.55rem; }
    .tx-blurb em { color: var(--accent); }
    .tx-count {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.9rem;
      padding-left: 1.75rem;
      border-left: 1px solid var(--border);
      text-decoration: none;
    }
    .tx-count-label {
      font: 500 11px/1.6 var(--font-mono);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .tx-count-num {
      font: 300 40px/1 var(--font-mono);
      color: var(--text-primary);
    }
    .tx-count-num::after { content: ""; display: block; width: 30px; height: 2px; margin-top: 0.7rem; background: var(--accent); }

    .tx-filters { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
    .filter-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      min-width: 150px;
      padding: 0.7rem 1.2rem;
      font: 500 11px var(--font-mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-secondary);
      background: transparent;
      border: 1px solid var(--border);
      cursor: pointer;
      white-space: nowrap;
      transition: color 0.2s, border-color 0.2s;
    }
    .filter-btn svg { width: 15px; height: 15px; }
    .filter-btn:hover { color: var(--text-primary); border-color: var(--text-subtle); }
    .filter-btn.active { color: var(--accent); border-color: var(--accent); }

    /* ---- project rows: text | image, alternating; the number rides with the text ---- */
    .tx-list { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 1px solid var(--border); }
    .tx-row {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
      grid-template-areas: "text media";
      align-items: center;
      gap: 2.5rem;
      padding: 1.75rem 0;
      border-bottom: 1px solid var(--border);
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tx-row.is-flip {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.85fr);
      grid-template-areas: "media text";
    }
    .tx-text {
      grid-area: text;
      align-self: start;
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 0 0.75rem;
      padding-top: 0.6rem;
    }
    .is-flip .tx-text { grid-template-columns: minmax(0, 1fr) 56px; }
    .is-flip .tx-num { order: 2; text-align: right; }
    .tx-num { font: 300 22px/1 var(--font-mono); color: var(--text-secondary); }
    .tx-num::after { content: ""; display: block; width: 22px; height: 2px; margin-top: 0.6rem; background: var(--accent); }
    .is-flip .tx-num::after { margin-left: auto; }

    .tx-media { grid-area: media; display: flex; gap: 10px; text-decoration: none; }
    .tx-main {
      flex: 1;
      aspect-ratio: 16 / 6.4;
      background: #000 center / cover no-repeat;
      border: 1px solid var(--border);
      transition: filter 0.4s;
    }
    .tx-thumbs { display: flex; flex-direction: column; gap: 8px; width: 13%; }
    .tx-thumbs span { flex: 1; background: #000 center / cover no-repeat; border: 1px solid var(--border); }
    .tx-row:hover .tx-main { filter: brightness(1.08); }

    .tx-kind {
      margin: 0 0 0.5rem;
      font: 400 11px var(--font-mono);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .tx-name {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(22px, 2vw, 30px);
      line-height: 1.05;
      text-transform: uppercase;
    }
    .tx-name a { color: var(--text-primary); text-decoration: none; transition: color 0.2s; }
    .tx-name a:hover { color: var(--accent); }
    .tx-desc {
      margin: 0.75rem 0 0;
      font: 400 12.5px/1.65 var(--font-mono);
      color: var(--text-secondary);
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .tx-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.95rem; }
    .tx-tags span {
      padding: 0.26rem 0.6rem;
      font: 400 10.5px var(--font-mono);
      color: var(--text-primary);
      border: 1px solid var(--border);
      white-space: nowrap;
    }
    .tx-cta {
      display: inline-block;
      margin-top: 1.1rem;
      font: 600 11.5px var(--font-mono);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      text-decoration: none;
    }
    .tx-cta span { display: inline-block; margin-left: 0.5em; transition: transform 0.25s; }
    .tx-row:hover .tx-cta span { transform: translateX(4px); }

    .project-card.card-hidden { opacity: 0; transform: translateY(8px); pointer-events: none; }

    /* ---- narrower screens: stack ---- */
    @media (max-width: 1000px) {
      .tx-head { grid-template-columns: minmax(0, 1fr) auto; }
      .tx-blurb { grid-column: 1 / -1; grid-row: 2; }
    }
    @media (max-width: 860px) {
      .tx-row, .tx-row.is-flip {
        grid-template-columns: 1fr;
        grid-template-areas: "media" "text";
        gap: 1.1rem;
        padding: 1.5rem 0;
      }
      .is-flip .tx-text { grid-template-columns: 44px minmax(0, 1fr); }
      .is-flip .tx-num { order: 0; text-align: left; }
      .is-flip .tx-num::after { margin-left: 0; }
      .tx-text { grid-template-columns: 44px minmax(0, 1fr); padding-top: 0; }
      .tx-thumbs { display: none; }
    }
    @media (max-width: 640px) {
      .tx-count { display: none; }
      .tx-head { grid-template-columns: 1fr; }
      .tx-blurb { grid-column: auto; grid-row: auto; padding-left: 1rem; }
      .filter-btn { flex: 1; min-width: 0; padding: 0.6rem 0.4rem; gap: 0.4rem; font-size: 10px; letter-spacing: 0.1em; }
    }
  </style>

  <script>
    const STORAGE_KEY = "techart-engine-filter";
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const rows = [...document.querySelectorAll<HTMLElement>(".project-card")];

    // After filtering, renumber the visible rows and keep their sides alternating.
    function relayout() {
      rows.filter((r) => r.style.display !== "none").forEach((r, i) => {
        r.classList.toggle("is-flip", i % 2 === 1);
        const num = r.querySelector(".tx-num");
        if (num) num.textContent = String(i + 1).padStart(2, "0");
      });
    }

    // `animate` = false skips the fade so re-applying a saved filter on load doesn't flash.
    function applyFilter(filter: string, animate = true) {
      const show = (r: HTMLElement) => filter === "all" || r.dataset.engine === filter;
      const swap = () => {
        rows.forEach((r) => (r.style.display = show(r) ? "" : "none"));
        relayout();
        requestAnimationFrame(() => rows.forEach((r) => show(r) && r.classList.remove("card-hidden")));
      };
      if (!animate) {
        rows.forEach((r) => r.classList.toggle("card-hidden", !show(r)));
        swap();
        return;
      }
      rows.forEach((r) => r.classList.add("card-hidden"));
      setTimeout(swap, 250);
    }

    function setActive(filter: string) {
      buttons.forEach((b) => b.classList.toggle("active", b.dataset.filter === filter));
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter || "all";
        setActive(filter);
        applyFilter(filter, true);
        try {
          sessionStorage.setItem(STORAGE_KEY, filter);
        } catch (e) {}
      });
    });

    // Restore the last-used filter (e.g. after going back from a project page).
    let saved = "all";
    try {
      saved = sessionStorage.getItem(STORAGE_KEY) || "all";
    } catch (e) {}
    if (saved !== "all") {
      setActive(saved);
      applyFilter(saved, false);
    }
  </script>
</Layout>
