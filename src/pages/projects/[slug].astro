---
import Layout from "../../layouts/Layout.astro";
import "../../styles/editorial.css";
import { allProjects } from "../../config";

export function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Detail-page banner: prefer `detailImage`, fall back to the tile `image`.
const bannerImage = project.hideDetailBanner ? "" : (project.detailImage || project.image || "");

const categoryHref =
  project.categoryKey === "professional" || project.categoryKey === "personal"
    ? "/tech-art"
    : "/random";

const categoryBackLabel =
  project.categoryKey === "professional" || project.categoryKey === "personal"
    ? "Techart"
    : project.categoryLabel;
---

<Layout title={project.name}>
  <section class="relative isolate overflow-hidden py-14 sm:py-16" style={{ backgroundColor: "var(--bg)" }}>
    <svg
      aria-hidden="true"
      class="absolute inset-0 -z-10 size-full opacity-[0.3] [mask-image:radial-gradient(100%_100%_at_top_left,white,transparent)]"
      style={{ stroke: "var(--grid-stroke)" }}
    >
      <defs>
        <pattern x="50%" y={-1} id="project-grid-pattern" width={40} height={40} patternUnits="userSpaceOnUse">
          <path d="M.5 40V.5H40" fill="none"></path>
        </pattern>
      </defs>
      <rect fill="url(#project-grid-pattern)" width="100%" height="100%" stroke-width={0}></rect>
    </svg>

    <div class="page-wrap">
      <a href={categoryHref} class="dp-back"><span aria-hidden="true">←</span> Back to {categoryBackLabel}</a>

      <!-- title block, same voice as the Techart page header -->
      <header class="dp-head animate-fade-in">
        <div>
          <p class="tx-kicker"><span>//</span> {project.categoryLabel}</p>
          <h1 class="tx-title">{project.name}</h1>
          {project.tagline && <p class="dp-tagline">{project.tagline}</p>}
        </div>
        {project.categoryKey === "professional" && (
          <span class="status-badge dp-badge">Live · Production Tested</span>
        )}
      </header>

      {bannerImage && (
        <div id="preview-banner" class="dp-banner corners">
          <div id="preview-image" style={`background-image: url('${bannerImage}')`}></div>
          <button id="preview-toggle" type="button" aria-label="Toggle full preview" class="dp-toggle">
            <svg id="preview-toggle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
            <span id="preview-toggle-label">Expand preview</span>
          </button>
        </div>
      )}

      <!-- Overview: tags + links on the left, the write-up on the right -->
      <div class="hs-inner dp-first">
        <div class="dp-side">
          <h2 class="dp-h">Overview</h2>
          <div class="rule mt-3"></div>
          {project.skills && project.skills.length > 0 && (
            <div class="tx-tags dp-tags">{project.skills.map((skill) => <span>{skill}</span>)}</div>
          )}
          {(project.link || project.demoLink) && (
            <div class="dp-links">
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="hs-btn">
                  {project.link.includes("github.com") && (
                    <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.0.069-.608.0 1.003.702 1.531 1.532 1.531.892 0 1.634-.559 2.03-1.02.086-.615.333-1.02.606-1.255-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.024A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.293 2.747-1.024 2.747-1.024.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
                  )}
                  View project <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.demoLink && (
                <a href={project.demoLink} target="_blank" rel="noopener noreferrer" class="hs-btn">
                  <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  View demo <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </div>

        <div class="dp-body">
          {project.longDescription?.map((paragraph) => <p>{paragraph}</p>)}
          {project.inlineImage && <img src={project.inlineImage} alt={project.name} class="dp-img" />}
          {project.galleryImages?.map((img) => <img src={img} alt={project.name} class="dp-img" />)}
        </div>
      </div>

      {project.usageNotes && (
        <div class="hs-inner">
          <div>
            <h2 class="dp-h">How to use</h2>
            <div class="rule mt-3"></div>
          </div>
          <ol class="dp-steps">
            {project.usageNotes.map((note, index) => (
              <li><span class="dp-step-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><p>{note}</p></li>
            ))}
          </ol>
        </div>
      )}

      <!-- Code (or the NDA note). The "Tutorial: coming soon" placeholder is switched off for now. -->
      {(project.ndaProtected || project.codeBlocks || project.code) && (
        <div class="hs-inner">
          <div>
            <h2 class="dp-h">{project.ndaProtected ? "Code under NDA" : "Code"}</h2>
            <div class="rule mt-3"></div>
          </div>
          {project.ndaProtected ? (
            <div class="dp-body dp-note">
              <p>
                This system is live in a shipped commercial title, so the actual source is covered by an NDA and I'm not able to share it publicly here. I've kept the write-up above focused on the how and the why — the architecture, the trade-offs, and how it's used in production.
              </p>
              <p>
                Happy to talk through the implementation in more detail in a conversation or interview — feel free to <a href="/contact">reach out</a>.
              </p>
            </div>
          ) : project.codeBlocks ? (
            <div class="dp-codes">
              {project.codeBlocks.map((block) => (
                <div class="dp-code">
                  <p class="dp-code-label">// {block.label}</p>
                  <pre><code>{block.code}</code></pre>
                </div>
              ))}
            </div>
          ) : (
            <div class="dp-code"><pre><code>{project.code}</code></pre></div>
          )}
        </div>
      )}

      {/*
      <div class="hs-inner">
        <div>
          <h2 class="dp-h">Tutorial</h2>
          <div class="rule mt-3"></div>
        </div>
        <div class="dp-body">
          <p>Coming soon — working on a write-up / video breakdown of how this one works.</p>
        </div>
      </div>
      */}
    </div>
  </section>
</Layout>

<script>
  const banner = document.getElementById("preview-banner");
  const toggle = document.getElementById("preview-toggle");
  const label = document.getElementById("preview-toggle-label");

  toggle?.addEventListener("click", () => {
    const expanded = banner?.classList.toggle("preview-expanded");
    if (label) label.textContent = expanded ? "Collapse preview" : "Expand preview";
  });
</script>

<style>
  .dp-back {
    display: inline-flex;
    gap: 0.6rem;
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .dp-back:hover { color: var(--accent); }
  .dp-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin-top: 2.25rem;
  }
  .dp-tagline {
    margin-top: 1rem;
    font: 400 15px/1.5 var(--font-mono);
    color: var(--text-secondary);
  }
  .dp-badge { flex-shrink: 0; margin-bottom: 0.3rem; }

  /* banner sits inside the content column; expand shows the whole image */
  .dp-banner {
    position: relative;
    height: clamp(220px, 34vw, 470px);
    margin-top: 2.25rem;
    border: 1px solid var(--border);
    background: #000;
    transition: height 0.4s ease;
  }
  #preview-image { position: absolute; inset: 0; background: center / cover no-repeat; }
  .dp-banner.preview-expanded { height: 85vh; }
  .dp-banner.preview-expanded #preview-image { background-size: contain; }
  .dp-toggle {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    font: 500 10.5px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: rgba(11, 11, 10, 0.82);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .dp-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .dp-toggle svg { width: 13px; height: 13px; transition: transform 0.3s; }
  .preview-expanded .dp-toggle svg { transform: rotate(180deg); }

  .dp-first { margin-top: 2.5rem; }
  .dp-h {
    font: 800 clamp(1.7rem, 2.4vw, 2.2rem)/1 var(--font-display);
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .dp-tags { margin-top: 1.6rem; }
  .dp-links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; margin-top: 1.75rem; }
  .dp-links .hs-btn { margin-top: 0; padding: 0.75rem 1.1rem; font-size: 11px; }
  .dp-links svg { width: 14px; height: 14px; }

  .dp-body { display: grid; gap: 1.25rem; max-width: 78ch; }
  .dp-body p {
    font: 400 13.5px/1.85 var(--font-mono);
    color: var(--text-secondary);
  }
  .dp-body a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .dp-img { width: 100%; height: auto; margin-top: 0.5rem; border: 1px solid var(--border); }

  .dp-steps { display: grid; gap: 1.1rem; max-width: 78ch; }
  .dp-steps li { display: grid; grid-template-columns: 44px 1fr; gap: 0.75rem; }
  .dp-step-num { font: 300 20px/1.2 var(--font-mono); color: var(--text-secondary); }
  .dp-step-num::after { content: ""; display: block; width: 18px; height: 2px; margin-top: 0.45rem; background: var(--accent); }
  .dp-steps p { font: 400 13.5px/1.8 var(--font-mono); color: var(--text-secondary); }

  .dp-codes { display: grid; gap: 1.25rem; min-width: 0; }
  .dp-code {
    min-width: 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }
  .dp-code-label {
    margin-bottom: 0.75rem;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dp-code pre { overflow-x: auto; font: 400 12.5px/1.7 var(--font-mono); color: var(--text-primary); }

  @media (max-width: 640px) {
    .dp-head { flex-direction: column; align-items: flex-start; }
    .dp-badge { order: -1; margin-bottom: 0; }
  }
</style>
