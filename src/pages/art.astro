---
// src/pages/art.astro
import Layout from "../layouts/Layout.astro";
import "../styles/editorial.css";
import { youtubeId, youtubeStart } from "../scripts/youtube-preview";

// Brand-logo path data (24x24 viewBox), rendered with currentColor.
// Tags without a known icon just show as plain text tags.
const TOOL_ICONS: Record<string, string> = {
  unity3d: "m12.9288 4.2939 3.7997 2.1929c.1366.077.1415.2905 0 .3675l-4.515 2.6076a.4192.4192 0 0 1-.4246 0L7.274 6.8543c-.139-.0745-.1415-.293 0-.3675l3.7972-2.193V0L1.3758 5.5977V16.793l3.7177-2.1456v-4.3858c-.0025-.1565.1813-.2682.318-.1838l4.5148 2.6076a.4252.4252 0 0 1 .2136.3676v5.2127c.0025.1565-.1813.2682-.3179.1838l-3.7996-2.1929-3.7178 2.1457L12 24l9.6954-5.5977-3.7178-2.1457-3.7996 2.1929c-.1341.082-.3229-.0248-.3179-.1838V13.053c0-.1565.087-.2956.2136-.3676l4.5149-2.6076c.134-.082.3228.0224.3179.1838v4.3858l3.7177 2.1456V5.5977L12.9288 0Z",
  maya: "M4.348 0 .69 2.203v16.875l3.657-2.203h17.297V1.219c0-.67-.551-1.219-1.22-1.219H4.349zm18.297 3.75v14.125H4.627l-1.943 1.17v3.736c0 .67.55 1.219 1.218 1.219H23.31V3.75h-.664zm-14.471.025h2.937l1.885 7.508 1.977-7.48-.012-.028h2.857v9.354h-2.216v-6.04l-1.565 6.026v.014h-2.203l-1.656-6.28v6.28H8.174V3.775zm1.33 14.762h1.18l1.068 3.543h-.902l-.217-.773H9.568l-.197.773h-.88l1.013-3.543zm1.918 0h.932l.648 1.494.643-1.494h.894l-1.113 2.133v1.41h-.887v-1.406l-1.117-2.137zm3.826 0h1.18l1.068 3.543h-.9l-.217-.773h-1.065l-.197.773h-.88l1.011-3.543zm-5.156.582-.362 1.53h.73l-.368-1.53zm5.744 0-.36 1.53h.73l-.37-1.53z",
  "3dsmax": "m.129 20.202 14.7-9.136h7.625c.235 0 .445.188.445.445 0 .21-.092.305-.21.375l-7.222 4.323c-.47.283-.633.845-.633 1.265l-.008 2.725H24V4.362a.561.561 0 0 0-.585-.562h-8.752L0 12.893V20.2h.129z",
};

function iconKeyFor(tag: string): string | undefined {
  const key = tag.toLowerCase().replace(/[^a-z0-9]/g, "");
  if (key.includes("unity")) return "unity3d";
  if (key.includes("maya")) return "maya";
  if (key.includes("3dsmax")) return "3dsmax";
  return undefined;
}

const ART_DEMO_BASE = "https://www.youtube.com/watch?v=_uy6NW5-vKE";

// Your 3D Art projects array dataset
const artProjects = [
  {
    title: "Unity Game Environment",
    tags: ["Unity3D", "Maya", "ZBrush", "Substance Painter"],
    artstationLink: "https://www.artstation.com/artwork/elN0BX",
    demoLink: `${ART_DEMO_BASE}&t=8s`,
  },
  {
    title: "Ornate Wine Chalice",
    tags: ["Maya", "ZBrush", "Marmoset Toolbag", "Substance Painter"],
    artstationLink: "https://www.artstation.com/artwork/Nyqg4z",
    demoLink: `${ART_DEMO_BASE}&t=90s`,
  },
  {
    title: "Snowy Environment",
    tags: ["Maya", "Substance Painter", "V-Ray", "ZBrush"],
    artstationLink: "https://www.artstation.com/artwork/aGKmlq",
    demoLink: `${ART_DEMO_BASE}&t=129s`,
  },
  {
    title: "Mech Robo",
    tags: ["3ds Max", "Substance Painter"],
    artstationLink: "https://www.artstation.com/artwork/Om13wv",
    demoLink: `${ART_DEMO_BASE}&t=160s`,
  },
  {
    title: "Scorpio",
    tags: ["Maya", "Arnold", "Substance Painter", "ZBrush"],
    artstationLink: "https://www.artstation.com/artwork/9NG8YO",
    demoLink: `${ART_DEMO_BASE}&t=185s`,
  },
  {
    title: "Elf Girl Portrait",
    tags: ["Maya", "Arnold", "ZBrush", "Substance Painter", "XGen"],
    artstationLink: "https://www.artstation.com/artwork/QndK1L",
    demoLink: `${ART_DEMO_BASE}&t=150s`,
  },
];
const pad = (n: number) => String(n).padStart(2, "0");

// Previews play straight from the showreel: each piece loops from its "Watch on YouTube" time
// until the next piece's time (the last one until just before the reel ends).
const ART_REEL_SECONDS = 216;
const starts = artProjects.map((a) => youtubeStart(a.demoLink)).sort((a, b) => a - b);
const clipOf = (link: string) => {
  const id = youtubeId(link), start = youtubeStart(link);
  const end = starts.find((t) => t > start) ?? ART_REEL_SECONDS - 1;
  return id ? { id, start, end } : null;
};
// "3D Art / Maya": the tool a piece was mainly built in (the first tag with a logo)
const kindOf = (tags: string[]) => `3D Art / ${tags.find((t) => iconKeyFor(t)) ?? tags[0]}`;
---

<Layout title="Art Portfolio">
  <section class="tx relative isolate overflow-hidden py-14 sm:py-16" style={{ backgroundColor: "var(--bg)" }}>
    <svg
      aria-hidden="true"
      class="absolute inset-0 -z-10 size-full opacity-[0.3] [mask-image:radial-gradient(100%_100%_at_top_left,white,transparent)]"
      style={{ stroke: "var(--grid-stroke)" }}
    >
      <defs>
        <pattern x="50%" y={-1} id="art-grid-pattern" width={40} height={40} patternUnits="userSpaceOnUse">
          <path d="M.5 40V.5H40" fill="none"></path>
        </pattern>
      </defs>
      <rect fill="url(#art-grid-pattern)" width="100%" height="100%" stroke-width={0}></rect>
    </svg>

    <div class="tx-wrap">
      <!-- page header: title | amber rule + blurb | selected-works count -->
      <header class="tx-head animate-fade-in">
        <div class="tx-title-col">
          <p class="tx-kicker"><span>//</span> Art</p>
          <h1 class="tx-title">Art<br /><span class="tx-outline">Projects</span></h1>
        </div>
        <div class="tx-blurb">
          <p>A few <em>3D and environment art pieces</em> I made purely because <em>I enjoyed making them</em>.</p>
          <p><em>Modeling, sculpting, and lighting</em> things just to see them come together.</p>
          <p>Click through to ArtStation for the full breakdowns, wireframes, and turntables.</p>
        </div>
        <a href="#works" class="tx-count" aria-label={`${artProjects.length} selected works`}>
          <span class="tx-count-label">Selected<br />works</span>
          <span class="tx-count-num">{pad(artProjects.length)}</span>
        </a>
      </header>

      <ol id="works" class="tx-list art-list">
        {artProjects.map((art, index) => {
          const iconKey = art.tags.map(iconKeyFor).find(Boolean);
          const clip = clipOf(art.demoLink);
          return (
            <li class={`tx-row${index % 2 ? " is-flip" : ""}`}>
              <a href={art.demoLink} target="_blank" rel="noopener noreferrer" class="tx-media" tabindex="-1" aria-hidden="true">
                {clip && (
                  <span class="tx-main corners tx-yt" data-yt={clip.id} data-start={clip.start} data-end={clip.end}>
                    <span class="tx-yt-clip"><span class="tx-yt-frame"></span></span>
                  </span>
                )}
              </a>
              <div class="tx-text">
                <span class="tx-num" aria-hidden="true">{pad(index + 1)}</span>
                <div class="tx-copy">
                  <p class="tx-kind">
                    {iconKey && (
                      <svg class="art-kind-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={TOOL_ICONS[iconKey]} /></svg>
                    )}
                    {kindOf(art.tags)}
                  </p>
                  <h2 class="tx-name"><a href={art.artstationLink} target="_blank" rel="noopener noreferrer">{art.title}</a></h2>
                  <div class="tx-tags">{art.tags.map((t) => <span>{t}</span>)}</div>
                  <div class="art-ctas">
                    {art.artstationLink && (
                      <a href={art.artstationLink} target="_blank" rel="noopener noreferrer" class="art-btn">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M0 17.723l2.027 3.505h.001a2.424 2.424 0 0 0 2.164 1.333h13.457l-2.792-4.838H0zm24 .19a2.41 2.41 0 0 0-.336-1.218L15.366 1.81a2.424 2.424 0 0 0-2.115-1.244H9.595l12.965 22.42 1.06-1.835A2.42 2.42 0 0 0 24 17.913zM12.453 7.555l4.515 7.823H7.937z" /></svg>
                        ArtStation
                      </a>
                    )}
                    {art.demoLink && (
                      <a href={art.demoLink} target="_blank" rel="noopener noreferrer" class="art-btn">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" /></svg>
                        YouTube
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</Layout>

<script>
  import { initYoutubePreviews } from "../scripts/youtube-preview";
  initYoutubePreviews();
</script>

<style>
  /* art pieces are mostly upright renders: a taller frame than Techart's wide captures */
  .art-list { margin-top: 2.25rem; }
  .art-list :global(.tx-main) { aspect-ratio: 16 / 9; }
  .art-kind-icon { display: inline-block; width: 14px; height: 14px; margin: -2px 0.55rem 0 0; vertical-align: middle; color: var(--text-primary); }
  /* outlined buttons, same build as the Techart engine filters */
  .art-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .art-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-width: 150px;
    padding: 0.7rem 1.2rem;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s;
  }
  .art-btn svg { width: 15px; height: 15px; }
  .art-btn:hover { color: var(--accent); border-color: var(--accent); }
</style>
