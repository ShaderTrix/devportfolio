---
// src/pages/pro-games.astro
import Layout from "../layouts/Layout.astro";
import "../styles/editorial.css";

const games = [
  {
    name: "Sorry! World",
    company: "Gameberry Labs",
    publisher: "Hasbro",
    role: "Technical Artist II",
    timeline: "2024 - Present",
    description:
      "I work on Sorry! World, the mobile take on the classic Hasbro board game, helping shape mechanics that keep players coming back — tuning and retesting based on real player feedback bumped retention by about 15%. Day to day I sit between art and engineering, making sure ideas from design and art actually run well in the game, and spend a good chunk of time digging into CPU/GPU performance so the game stays smooth even on older, low-end phones.",
    contributions: [
      "Tuned gameplay mechanics that lifted player retention by ~15%",
      "Bridged art and engineering in a fast-paced live-ops environment",
      "Optimized CPU-GPU workloads to keep frame times stable on low-end devices",
    ],
    image: "/games/sorry.webp",
    androidLink:
      "https://play.google.com/store/apps/details?id=com.gameberry.sorry.card.board.game&hl=en_IN",
    iosLink:
      "https://apps.apple.com/in/app/sorry-world-board-game/id6749000283?l=hi&platform=ipad",
  },
  {
    name: "Backgammon Friends Online",
    company: "Gameberry Labs",
    publisher: "",
    role: "Associate Technical Artist",
    timeline: "3-4 months",
    description:
      "I helped out with techart on Backgammon Friends Online for a few months as an associate on the team, picking up smaller tasks and supporting the rest of the techart work wherever it was needed.",
    contributions: [
      "Helped with techart tasks and support across the project",
    ],
    image: "/games/backgammon.webp",
    androidLink:
      "https://play.google.com/store/apps/details?id=com.gameberrylabs.backgammonfriends&hl=en",
    iosLink: "https://apps.apple.com/us/app/backgammon-friends-online/id6446756885",
  },
  {
    name: "GameStarz",
    company: "Dirtcube Interactive LLP",
    publisher: "",
    role: "3D Artist",
    timeline: "Mar 2021 - Jul 2024",
    description:
      "On GameStarz I created the 3D models, textures, and environments that filled out the game's world, working across Blender, Substance, Photoshop, and Unity. I also rigged and animated characters to bring them to life, and set up real-time lighting and rendering in Unity that looked good without tanking performance. A lot of the job was just making sure everything I built ran cleanly in the actual game, not just in a render.",
    contributions: [
      "Modeled and textured 3D environments and props for the game's world",
      "Rigged and animated characters to bring them to life",
      "Set up real-time lighting and rendering in Unity with performance in mind",
    ],
    image: "/games/gamestarz.webp",
    androidLink: "https://play.google.com/store/apps/details?id=com.dirtcube.gamestarz&hl=en_IN",
    iosLink: "https://apps.apple.com/in/app/gamestarz-metaverse-of-games/id1617812520?l=hi",
  },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="Games I've Worked On">
  <section class="tx relative isolate overflow-hidden py-14 sm:py-16" style={{ backgroundColor: "var(--bg)" }}>
    <svg
      aria-hidden="true"
      class="absolute inset-0 -z-10 size-full opacity-[0.3] [mask-image:radial-gradient(100%_100%_at_top_left,white,transparent)]"
      style={{ stroke: "var(--grid-stroke)" }}
    >
      <defs>
        <pattern x="50%" y={-1} id="games-grid-pattern" width={40} height={40} patternUnits="userSpaceOnUse">
          <path d="M.5 40V.5H40" fill="none"></path>
        </pattern>
      </defs>
      <rect fill="url(#games-grid-pattern)" width="100%" height="100%" stroke-width={0}></rect>
    </svg>

    <div class="tx-wrap">
      <!-- page header: title | amber rule + blurb | shipped-titles count -->
      <header class="tx-head animate-fade-in">
        <div class="tx-title-col">
          <p class="tx-kicker"><span>//</span> Games</p>
          <h1 class="tx-title">Games I've<br />Worked On</h1>
        </div>
        <div class="tx-blurb">
          <p>A few <em>shipped, real-world titles</em> with my fingerprints on them — <em>millions of players</em>, occasional fires to put out, and a lot of <em>"why is the frame rate doing that" moments</em> along the way.</p>
        </div>
        <a href="#works" class="tx-count" aria-label={`${games.length} shipped titles`}>
          <span class="tx-count-label">Shipped<br />titles</span>
          <span class="tx-count-num">{pad(games.length)}</span>
        </a>
      </header>

      <ol id="works" class="tx-list games-list">
        {games.map((game, index) => (
          <li class={`tx-row${index % 2 ? " is-flip" : ""}`}>
            <div class="tx-media">
              <span class="tx-main" style={`background-image: url('${game.image}')`}></span>
            </div>
            <div class="tx-text">
              <span class="tx-num" aria-hidden="true">{pad(index + 1)}</span>
              <div class="tx-copy">
                <p class="tx-kind">{game.company}{game.publisher && ` · Licensed by ${game.publisher}`}</p>
                <h2 class="tx-name">{game.name}</h2>
                <p class="game-role">{game.role}<span aria-hidden="true">/</span>{game.timeline}</p>
                <p class="tx-desc game-desc">{game.description}</p>
                <p class="game-sub">// Key contributions</p>
                <ul class="game-list">
                  {game.contributions.map((bullet) => <li>{bullet}</li>)}
                </ul>
                <div class="game-ctas">
                  <a href={game.androidLink} target="_blank" rel="noopener noreferrer" class="tx-cta">
                    <img src="/icons/google-play.svg" alt="" />Google Play <span aria-hidden="true">→</span>
                  </a>
                  <a href={game.iosLink} target="_blank" rel="noopener noreferrer" class="tx-cta">
                    <img src="/icons/app-store.svg" alt="" />App Store <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .games-list { margin-top: 2.25rem; }
  .games-list .tx-main { aspect-ratio: 16 / 9; }
  .games-list .tx-row { align-items: start; }
  .game-role {
    margin-top: 0.6rem;
    font: 500 12px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--text-primary);
  }
  .game-role span { margin: 0 0.6em; color: var(--accent); }
  /* the full write-up, not the 3-line teaser Techart uses */
  .game-desc { display: block; -webkit-line-clamp: unset; overflow: visible; }
  .game-sub {
    margin-top: 1.1rem;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .game-list { display: grid; gap: 0.4rem; margin-top: 0.6rem; }
  .game-list li {
    position: relative;
    padding-left: 1.1rem;
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--text-primary);
  }
  .game-list li::before { content: "›"; position: absolute; left: 0; color: var(--accent); }
  .game-ctas { display: flex; flex-wrap: wrap; gap: 0 1.75rem; }
  .game-ctas img { display: inline-block; width: 13px; height: 13px; margin: -2px 0.55rem 0 0; vertical-align: middle; }
  .game-ctas img[src*="app-store"] { filter: invert(0.92); }   /* black logo: it used to sit on an amber button */
  .games-list .tx-row:hover .tx-cta span { transform: none; }
  .game-ctas .tx-cta:hover span { transform: translateX(4px); }
</style>
