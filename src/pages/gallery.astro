---
// Standalone interactive 3D landing (the same scene the home page opens with).
import GalleryScene from "../components/GalleryScene.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const s = siteConfig;
const ogImage = new URL(s.ogImage, s.siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{s.siteTitle}</title>
    <meta name="description" content={s.description} />
    <link rel="canonical" href={new URL("/gallery", s.siteUrl).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={s.siteTitle} />
    <meta property="og:description" content={s.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="gallery-body">
    <GalleryScene />
    <style is:global>
      .gallery-body { margin: 0; background: #050505; overflow: hidden; }
    </style>
  </body>
</html>
