---
// Standalone interactive 3D landing (the same scene the home page opens with).
import GalleryScene from "../components/GalleryScene.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const s = siteConfig;
const role = s.title.split("|")[0].trim().replace(/\s+II$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{s.name} - {role}</title>
    <meta name="description" content={s.description} />
  </head>
  <body class="gallery-body">
    <GalleryScene />
    <style is:global>
      .gallery-body { margin: 0; background: #050505; overflow: hidden; }
    </style>
  </body>
</html>
